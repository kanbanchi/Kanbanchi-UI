{
  "compilerOptions": {
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "jsx": "react",
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "./src/ui/**/*"
  ]
}
